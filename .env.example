# ===========================================================================
# DIAGNASSIS environment variables. Copy to .env.local for local development.
# NEVER commit real values. "Browser-safe" values are exposed to client code.
# ===========================================================================

# --- Supabase (required) ----------------------------------------------------
# Project URL. Supabase dashboard -> Project Settings -> API. Browser-safe. Required: all environments.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (or legacy anon) key. Same page. Browser-safe: RLS protects the data. Required: all environments.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Public base URL of this app (used in auth e-mail redirects). Browser-safe. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Service-role / secret key. SERVER-ONLY, bypasses RLS. Required for: AI question bank, custom-role estimates,
# market research, R2 report metadata, AI request logging. Netlify: mark as secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- NVIDIA AI (required for all AI features) -------------------------------
# API key from https://build.nvidia.com (nvapi-...). SERVER-ONLY.
NVIDIA_API_KEY=
# Optional. OpenAI-compatible endpoint. Default: https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=
# Optional. Chat model id available to your key. Default: meta/llama-3.3-70b-instruct
NVIDIA_MODEL=
# Optional. Per-request timeout in milliseconds. Default: 25000
NVIDIA_TIMEOUT_MS=

# --- Cloudflare R2 (optional; PDF reports are streamed directly if unset) ---
# R2 -> Manage R2 API Tokens. SERVER-ONLY. All four are required to enable R2 storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional custom endpoint (e.g. jurisdiction-specific). Default: https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Scheduled market research (required in production) ---------------------
# Random string, >= 24 chars (openssl rand -hex 32). SERVER-ONLY. Shared by the Netlify
# scheduled function and /api/cron/market-research.
CRON_SECRET=
